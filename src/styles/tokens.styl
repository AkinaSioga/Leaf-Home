dark-tokens()
  color-scheme dark
  --page-bg #080e1c
  --page-bg-accent #121a30
  --surface #141e32
  --surface-raised #141e32
  --surface-muted #1c2941
  --glass-surface rgba(20, 30, 50, .66)
  --glass-border rgba(192, 208, 255, .2)
  --glass-sheen linear-gradient(135deg, rgba(211, 221, 255, .07), rgba(211, 221, 255, 0) 60%)
  --ambient-rose rgba(126, 105, 196, .22)
  --ambient-blue rgba(64, 143, 184, .2)
  --text-primary #ebedf8
  --text-secondary #b5bfd5
  --text-soft #9eaac4
  --line-soft rgba(170, 186, 226, .14)
  --accent-blue #9c9fe5
  --accent-blue-strong #c1c3ff
  --accent-pink #9c9fe5
  --accent-pink-strong #c1c3ff
  --accent-cyan #81cedf
  --accent-tint #2b3657
  --focus-ring #9c9fe5
  --shadow-soft 0 6px 24px rgba(0, 0, 0, .15), inset 0 1px 0 rgba(223, 232, 255, .08)
  --shadow-card 0 10px 35px rgba(0, 0, 0, .2)
  --hero-overlay linear-gradient(90deg, rgba(6, 14, 35, .5), rgba(6, 14, 35, .02) 68%)
  --hero-position center 17%
  --hero-text #fff
  --hero-copy-align 0
  --hero-copy-width 50%
  --home-hero-width calc(100% - 7rem)
  --home-hero-max-width calc(var(--content-width) - 4rem)
  --home-hero-copy-width 50%
  --logo-filter invert(1)
  --logo-blend screen
  --light-display none
  --dark-display block

:root
  --font-site "LXGW 975 Yuan", "Microsoft YaHei", system-ui, sans-serif
  color-scheme light
  --page-bg #fbf7fb
  --page-bg-accent #f4edf7
  --surface #fff
  --surface-raised #fff
  --surface-muted #f7f0f6
  --glass-surface rgba(255, 255, 255, .62)
  --glass-border rgba(255, 255, 255, .82)
  --glass-sheen linear-gradient(135deg, rgba(255, 255, 255, .32), rgba(255, 255, 255, 0) 60%)
  --ambient-rose rgba(226, 163, 199, .3)
  --ambient-blue rgba(153, 201, 225, .32)
  --glass-blur 22px
  --text-primary #343245
  --text-secondary #6d6274
  --text-soft #7e7083
  --line-soft rgba(121, 90, 127, .12)
  --accent-blue #ce789f
  --accent-blue-strong #a44c78
  --accent-pink #ce789f
  --accent-pink-strong #a44c78
  --accent-cyan #77b2cc
  --accent-tint #f9e6f0
  --focus-ring #ce789f
  --shadow-soft 0 6px 24px rgba(105, 61, 104, .07), inset 0 1px 0 rgba(255, 255, 255, .8)
  --shadow-card 0 10px 30px rgba(105, 61, 104, .09)
  --radius-lg 1.4rem
  --radius-md 1.2rem
  --content-width 86rem
  --sidebar-width 14.5rem
  --utility-width 14rem
  --hero-overlay linear-gradient(90deg, transparent 30%, rgba(255, 248, 236, .32) 60%, rgba(255, 248, 236, .66))
  --hero-position center 39%
  --hero-text #5c4055
  --hero-copy-align auto
  --hero-copy-width 44%
  --home-hero-width calc(100% - 3rem)
  --home-hero-max-width none
  --home-hero-copy-width max-content
  --logo-filter none
  --logo-blend multiply
  --light-display block
  --dark-display none

:root[data-theme='dark']
  dark-tokens()

@media (prefers-color-scheme: dark)
  :root:not([data-theme])
    dark-tokens()
