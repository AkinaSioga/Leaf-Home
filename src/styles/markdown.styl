.markdown-body
  overflow-wrap anywhere
  line-height 1.9
  h1, h2, h3, h4
    line-height 1.5
    margin 1.7em 0 .7em
  p, ul, ol, blockquote
    margin 1.2em 0
  a
    color var(--literary-accent, var(--accent-blue-strong))
    text-underline-offset .2em
  img
    max-width 100%
    height auto
    border-radius .5rem
  blockquote
    margin-inline 0
    padding .2rem 1.2rem
    border-left 2px solid var(--literary-accent, var(--accent-pink))
    color var(--literary-muted, var(--text-secondary))
    p
      text-indent 0
  pre
    min-width 0
    max-width 100%
    overflow-x auto
    padding 1.2rem
    border-radius .6rem
    font-size .85rem
    line-height 1.75
    letter-spacing 0
    border 1px solid rgba(139, 148, 158, .2)
    tab-size 2
    code
      font-family var(--font-site)
      font-size inherit
  :not(pre) > code
    padding .15em .35em
    border-radius .25rem
    background var(--surface-muted)
    font-size .9em
  table
    display block
    max-width 100%
    overflow-x auto
    border-collapse collapse
    font-size .9em
  th, td
    padding .5rem .8rem
    border 1px solid var(--literary-rule, var(--line-soft))
  hr
    border 0
    border-top 1px solid var(--literary-rule, var(--line-soft))
    margin 2rem 0
  li > p
    text-indent 0

.draft-banner
  position relative
  z-index 3
  padding .55rem 1rem
  background #393047
  color #f6e8ef
  text-align center
  font-size .75rem
  line-height 1.6

.article-card h3 a, .article-card__meta a, .article-card__tags a, .tag-cloud a
  text-decoration none
  &:hover
    color var(--accent-blue-strong)
    text-decoration underline
    text-underline-offset .2em

.article-card__tags a, .tag-cloud a
  color var(--text-secondary)
  font-size .75rem

.back-link
  display inline-flex
  align-items center
  min-height 2.75rem
  margin-bottom 1rem
  color var(--accent-blue-strong)
  text-decoration none

.post-page
  max-width 52rem
  margin-inline auto
  padding clamp(1.3rem, 4vw, 3.5rem)

.post-heading
  border-bottom 1px solid var(--line-soft)
  margin-bottom 2rem
  padding-bottom 1.5rem
  > a
    color var(--accent-blue-strong)
    font-size .85rem
  h1
    font-size clamp(1.8rem, 4vw, 2.5rem)
    margin .6rem 0
    line-height 1.4

.post-meta
  color var(--text-soft)
  font-size .8rem

.post-description
  color var(--text-secondary)
  line-height 1.8

.post-body
  font-size 1.05rem

.post-tags
  display flex
  flex-wrap wrap
  gap .8rem
  margin-top 2.5rem
  padding-top 1.25rem
  border-top 1px solid var(--line-soft)
  a
    color var(--accent-blue-strong)
    font-size .85rem
    text-decoration none

.archive-page
  max-width 58rem
  display grid
  gap 1.3rem

.archive-heading
  p
    color var(--text-soft)
    font-size .8rem
    margin 0
  h1
    font-size 2rem
    margin .5rem 0 1rem

.not-found
  text-align center
  padding-block 5rem

.series-intro
  max-width 42rem
  color var(--literary-muted)
  font-family var(--font-site)

.writing-empty
  padding 1.5rem 0
  color var(--literary-muted)
  font-family var(--font-site)
  line-height 1.9
  border-bottom 1px solid var(--literary-rule)

.reader-nav.reader-nav--chapters
  display grid
  grid-template-columns minmax(0, 1fr) auto minmax(0, 1fr)
  align-items center
  > :last-child
    justify-self end
    text-align right
  > span
    color var(--literary-muted)

@media (max-width: 47rem)
  .reader-nav.reader-nav--chapters
    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
    > :nth-child(2)
      grid-column 1 / -1
      grid-row 2
      justify-self center
