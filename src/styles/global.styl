@import './tokens.styl'

*
  box-sizing border-box

html
  scroll-behavior smooth
  scroll-padding-top 1.5rem
  background var(--page-bg)

body
  min-width 20rem
  min-height 100vh
  margin 0
  color var(--text-primary)
  background radial-gradient(ellipse at 8% 35%, rgba(102, 140, 255, .07), transparent 35rem), radial-gradient(ellipse at 96% 80%, rgba(255, 131, 182, .06), transparent 30rem), var(--page-bg)
  font-family var(--font-site)
  font-weight 500
  line-height 1.7

a
  color inherit

button, a, summary
  -webkit-tap-highlight-color transparent

button, input, textarea, select
  font inherit

code, pre, kbd, samp
  font-family var(--font-site)

:focus-visible
  outline 3px solid var(--accent-blue)
  outline-offset 4px

[hidden]
  display none !important

.hero
  position relative
  isolation isolate
  min-height 28rem
  color #fff
  background #101a34

  &::before
    content ''
    position absolute
    inset 4.5rem 0 0
    z-index -2
    background linear-gradient(90deg, rgba(8, 14, 39, .55), rgba(8, 14, 39, .05) 65%), var(--hero-image) center 35% / cover no-repeat

  &::after
    content ''
    position absolute
    inset auto 0 0
    height 4rem
    z-index -1
    background linear-gradient(transparent, var(--page-bg))

.hero--compact
  min-height 0
  background none

  &::before, &::after
    display none

.site-nav
  position relative
  z-index 10
  display grid
  grid-template-columns 1fr auto auto
  align-items center
  gap 1.5rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  min-height 4.5rem
  margin auto
  padding .65rem 1.25rem
  border 1px solid var(--line-soft)
  border-top 0
  border-radius 0 0 1rem 1rem
  background var(--surface-raised)

.site-nav__brand
  display inline-flex
  align-items center
  gap .7rem
  width fit-content
  color var(--text-primary)
  font-size 1.1rem
  font-weight 750
  text-decoration none
  white-space nowrap

.site-nav__logo
  width 2.25rem
  height 2.25rem
  border-radius .55rem
  object-fit cover

.site-nav__links
  display flex
  align-items center
  gap .45rem

  a
    position relative
    display inline-flex
    align-items center
    justify-content center
    min-height 2.75rem
    padding .4rem .9rem
    border-radius .5rem
    color var(--text-secondary)
    font-size .95rem
    font-weight 600
    white-space nowrap
    text-decoration none

    &:hover
      color var(--accent-pink-strong)
      background var(--surface-muted)

    &[aria-current='page']
      color var(--accent-pink-strong)

      &::after
        content ''
        position absolute
        bottom .15rem
        left 30%
        right 30%
        height 2px
        background currentColor

.site-nav__theme
  position relative

.hero__content
  width calc(100% - 5rem)
  max-width calc(var(--content-width) - 2rem)
  margin 5.5rem auto 0
  padding-bottom 6rem

  h1
    margin 0
    max-width 55%
    font-family var(--font-site)
    font-size clamp(2rem, 3.6vw, 3.2rem)
    font-weight 600
    line-height 1.4
    letter-spacing .07em
    text-shadow 0 2px 15px rgba(8, 14, 39, .35)

.hero__subtitle
  max-width 50%
  margin 1rem 0 0
  color #ecedf7
  font-size 1rem
  text-shadow 0 1px 8px #10182f

.home-shell
  position relative
  z-index 2
  display grid
  grid-template-columns var(--sidebar-width) minmax(0, 1fr)
  grid-template-areas 'sidebar content'
  align-items start
  gap 1.5rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin -1.5rem auto 0

.content-column
  display grid
  grid-area content
  min-width 0
  gap 1.25rem

.sidebar
  display grid
  grid-area sidebar
  min-width 0
  gap 1rem

.side-card, .article-card, .page-panel
  border 1px solid var(--line-soft)
  border-radius var(--radius-md)
  background var(--surface-raised)

.side-card
  min-width 0
  padding 1.1rem

  h2
    margin 0 0 .65rem
    font-size 1rem
    font-weight 700

  p
    margin .3rem 0 0
    color var(--text-secondary)
    font-size .85rem

.side-card__eyebrow, .section-heading__eyebrow
  margin 0 0 .3rem
  color var(--accent-blue-strong)
  font-size .7rem
  font-weight 650
  letter-spacing .1em
  text-transform uppercase

.profile-card__intro
  display flex
  gap .9rem
  align-items center

.profile-card__avatar
  flex-shrink 0
  width 4.5rem
  height 4.5rem
  object-fit cover
  border-radius .75rem

.profile-card h2
  margin-bottom .15rem
  font-size 1.05rem

.profile-card__status
  display flex
  align-items center
  gap .5rem
  margin-top 1rem
  color var(--text-soft)
  font-size .75rem

  span
    width .45rem
    height .45rem
    flex-shrink 0
    border-radius 50%
    background #66c99a

.side-card__count
  color var(--text-soft)
  font-size .8rem

.side-card__heading
  display flex
  justify-content space-between
  align-items center

.tag-cloud
  display flex
  flex-wrap wrap
  gap .4rem

  a
    padding .2rem .6rem
    border-radius .45rem
    color var(--text-secondary)
    background var(--surface-muted)
    font-size .75rem

.archive-card
  padding 0

  summary
    cursor pointer
    padding 1rem 1.1rem
    font-size .95rem
    font-weight 650

  .archive-card__body
    padding 0 .85rem 1rem

  .archive-list
    padding-left 1.3rem
    color var(--text-secondary)
    font-size .8rem

.article-section
  min-width 0

.section-heading
  display flex
  align-items center
  justify-content space-between
  gap 1rem
  margin .2rem 0 1rem

  h2, h1
    margin 0
    font-size 1.4rem
    line-height 1.5
    font-weight 700

  > span
    color var(--text-soft)
    font-size .8rem

.article-list
  display grid
  gap 1rem

.article-card
  padding 1.5rem 1.65rem

  h3
    position relative
    margin 0 0 .6rem
    font-size 1.35rem
    line-height 1.5

    &::before
      content ''
      position absolute
      left -1.65rem
      top .3rem
      width 3px
      height 1.3rem
      border-radius 2px
      background var(--accent-pink)

  p
    margin .8rem 0
    color var(--text-secondary)
    font-size .95rem

.article-card__meta, .article-card__tags
  display flex
  flex-wrap wrap
  gap .5rem .8rem
  color var(--text-soft)
  font-size .78rem

.article-card__tags a
  padding .1rem .5rem
  border-radius .4rem
  background var(--surface-muted)
  color var(--text-secondary)

.empty-state
  padding 3rem 1.5rem
  color var(--text-secondary)
  text-align center

.site-footer
  display flex
  flex-wrap wrap
  align-items center
  justify-content space-between
  gap .6rem 1.5rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin 2.5rem auto 0
  padding 1.4rem 0 2rem
  border-top 1px solid var(--line-soft)
  color var(--text-soft)
  font-size .75rem

  p
    margin 0

.page-shell
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin 3rem auto 0

.page-panel
  padding clamp(1.25rem, 4vw, 3rem)

.prose
  max-width 68ch
  color var(--text-secondary)
  line-height 1.9

@media (max-width: 60rem)
  :root
    --sidebar-width 14rem

  .site-nav
    gap .6rem

  .site-nav__links
    gap .1rem

    a
      padding .4rem .65rem

  .home-shell
    gap 1rem

  .profile-card__intro
    flex-direction column
    align-items flex-start

  .hero
    min-height 24rem

  .hero--compact
    min-height 0

  .hero__content
    margin-top 4rem

@media (max-width: 47rem)
  .site-nav
    grid-template-columns 1fr auto
    gap .2rem 1rem
    width 100%
    padding .6rem 1rem .35rem
    border-radius 0
    border-inline 0

  .site-nav__brand
    font-size 1rem

  .site-nav__links
    grid-column 1 / -1
    grid-row 2
    justify-content space-between
    gap .1rem

    a
      flex 1
      padding .35rem .4rem
      font-size .875rem

  .site-nav__theme
    grid-column 2
    grid-row 1

  .hero
    min-height 0

    &::before
      top 7rem
      background-position center, 15% 35%

  .hero--compact
    background none

  .hero__content
    width calc(100% - 2rem)
    margin 0 auto
    padding 3.5rem 0 4.5rem

    h1
      max-width 100%
      font-size clamp(1.5rem, 5.8vw, 2rem)
      letter-spacing .02em

  .hero__subtitle
    max-width 52%
    margin-top .8rem
    font-size .8rem

  .home-shell
    width calc(100% - 2rem)
    grid-template-columns minmax(0, 1fr)
    grid-template-areas 'content' 'sidebar'
    margin -1rem auto 0
    gap 1.5rem

  .content-column
    gap 1rem

  .sidebar
    grid-template-columns repeat(2, minmax(0, 1fr))

  .profile-card
    grid-column 1 / -1

  .profile-card__intro
    flex-direction row
    align-items center

  .profile-card__status
    margin-top .65rem

  .article-card
    padding 1.15rem 1.25rem

    h3
      font-size 1.15rem

      &::before
        left -1.25rem

  .section-heading h2
    font-size 1.15rem

  .page-shell
    width calc(100% - 2rem)
    margin-top 1.5rem

  .site-footer
    width calc(100% - 2rem)
    flex-direction column
    text-align center

@media (max-width: 30rem)
  .sidebar
    grid-template-columns minmax(0, 1fr)

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation none !important
    transition none !important
    scroll-behavior auto !important
