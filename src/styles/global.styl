@import './tokens.styl'

*
  box-sizing border-box

html
  scroll-behavior smooth
  scroll-padding-top 1.5rem
  background var(--page-bg)

body
  min-width 20rem
  min-height 100vh
  margin 0
  color var(--text-primary)
  background radial-gradient(ellipse 55rem 35rem at 10% 34rem, var(--ambient-rose), transparent 75%), radial-gradient(ellipse 60rem 40rem at 95% 65rem, var(--ambient-blue), transparent 75%), var(--page-bg)
  font-family var(--font-site)
  font-weight 500
  line-height 1.7

a
  color inherit

button, a, summary
  -webkit-tap-highlight-color transparent

button, input, textarea, select, code, pre, kbd, samp
  font-family var(--font-site)

:focus-visible
  outline 3px solid var(--focus-ring)
  outline-offset 4px

[hidden]
  display none !important

.theme-light-only
  display var(--light-display)

.theme-dark-only
  display var(--dark-display)

.hero
  --hero-bg var(--hero-image-light)
  position relative
  isolation isolate
  padding-top 1rem
  color var(--hero-text)
  background var(--page-bg-accent)
  &::before
    content ''
    position absolute
    inset 0
    z-index -1
    background-image var(--hero-overlay), var(--hero-bg)
    background-position center, var(--hero-position)
    background-size cover
    background-repeat no-repeat

.hero--compact
  background none
  &::before
    display none

:root[data-theme='dark'] .hero
  --hero-bg var(--hero-image-dark)

@media (prefers-color-scheme: dark)
  :root:not([data-theme]) .hero
    --hero-bg var(--hero-image-dark)

.site-nav
  position relative
  z-index 10
  display grid
  grid-template-columns 1fr auto auto
  align-items center
  gap 1.5rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  min-height 3.75rem
  margin auto
  padding .35rem 1.25rem
  border 1px solid var(--line-soft)
  border-radius 1.25rem
  background var(--surface-raised)
  box-shadow var(--shadow-soft)

.site-nav__brand
  display inline-flex
  align-items center
  gap .65rem
  width fit-content
  color var(--text-primary)
  font-size 1.1rem
  font-weight 750
  text-decoration none
  white-space nowrap

.site-nav__logo
  width 2.1rem
  height 2.1rem
  object-fit contain
  filter var(--logo-filter)
  mix-blend-mode var(--logo-blend)

.site-nav__links
  display flex
  align-items center
  gap .45rem
  a
    display inline-flex
    align-items center
    justify-content center
    min-height 2.5rem
    padding .35rem 1.1rem
    border-radius .85rem
    color var(--text-secondary)
    font-size .95rem
    font-weight 650
    white-space nowrap
    text-decoration none
    transition background .2s, color .2s
    &:hover, &[aria-current='page']
      color var(--accent-blue-strong)
      background var(--accent-tint)

.site-nav__theme
  position relative

.hero__content
  width calc(100% - 7rem)
  max-width calc(var(--content-width) - 4rem)
  margin auto
  min-height 23rem
  display flex
  align-items center
  padding 3rem 0 5rem

.hero__copy
  width var(--hero-copy-width)
  margin-left var(--hero-copy-align)
  h1
    margin 0
    font-size clamp(1.9rem, 3vw, 2.85rem)
    line-height 1.55
    font-weight 700
    letter-spacing .045em
    text-wrap balance
    text-shadow 0 2px 20px rgba(22, 25, 42, .12)
  h1 .theme-light-only
    font-size clamp(1rem, 2vw, 2rem)
    line-height 1.8
    letter-spacing .02em
    > span
      display block
      white-space nowrap

.hero__subtitle
  margin 1rem 0 0
  font-size 1rem
  text-shadow 0 1px 10px rgba(22, 25, 42, .18)

// Let the light quote hug the right inset instead of occupying the portrait area.
.hero--home .hero__content
  width var(--home-hero-width)
  max-width var(--home-hero-max-width)

.hero--home .hero__copy
  width var(--home-hero-copy-width)

.hero__edge
  position absolute
  bottom -1px
  left 0
  width 100%
  height 3.2rem
  color var(--page-bg)
  pointer-events none

.home-shell
  position relative
  z-index 2
  display grid
  grid-template-columns var(--sidebar-width) minmax(0, 1fr) var(--utility-width)
  grid-template-areas 'sidebar content utility'
  align-items start
  gap 1.25rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin .5rem auto 0

.home-shell--compact
  margin-top 1.5rem

.content-column
  display grid
  grid-area content
  min-width 0
  gap 1rem

.sidebar, .utility-sidebar
  display grid
  min-width 0
  gap 1rem

.sidebar
  grid-area sidebar

.utility-sidebar
  grid-area utility

.side-card, .article-card, .page-panel
  border 1px solid var(--line-soft)
  border-radius var(--radius-md)
  background var(--surface-raised)
  box-shadow var(--shadow-soft)

.side-card
  min-width 0
  padding 1rem
  h2
    display flex
    align-items center
    gap .5rem
    margin 0 0 .8rem
    font-size .95rem
    font-weight 700
    [data-icon]
      width 1.15rem
      height 1.15rem
      flex-shrink 0
      color var(--accent-blue)
  p
    margin .3rem 0 0
    color var(--text-secondary)
    font-size .85rem

.side-card__heading
  display flex
  justify-content space-between
  align-items center

.side-card__eyebrow, .section-heading__eyebrow
  color var(--accent-blue-strong)
  font-size .7rem
  letter-spacing .1em

.side-card__count
  color var(--text-soft)
  font-size .8rem

.section-heading
  display flex
  align-items center
  gap .7rem
  margin 0 0 1rem
  padding .9rem 1.25rem
  border-radius var(--radius-md)
  background var(--surface-raised)
  border 1px solid var(--line-soft)
  box-shadow var(--shadow-soft)
  h2, h1
    position relative
    margin 0
    padding-left .8rem
    font-size 1.2rem
    line-height 1.5
    font-weight 700
    &::before
      content ''
      position absolute
      top .2em
      bottom .2em
      left 0
      width 4px
      border-radius 4px
      background var(--accent-pink)
  > span
    color var(--text-secondary)
    background var(--accent-tint)
    font-size .75rem
    border-radius .6rem
    padding .1rem .55rem
    white-space nowrap

.article-section
  min-width 0

.filter-empty, .empty-state
  padding 2rem 1.5rem
  border-radius var(--radius-md)
  background var(--surface-muted)
  color var(--text-secondary)

.filter-empty button
  margin-left .5rem
  border 0
  background transparent
  color var(--accent-blue-strong)
  text-decoration underline
  cursor pointer

.site-footer
  display flex
  flex-wrap wrap
  align-items center
  justify-content center
  gap .5rem 1.5rem
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin 2rem auto 0
  padding 1.5rem 0 2rem
  color var(--text-soft)
  font-size .75rem
  p
    margin 0

.page-shell
  width calc(100% - 3rem)
  max-width var(--content-width)
  margin 2rem auto 0

.page-panel
  padding clamp(1.25rem, 3vw, 2.5rem)

.prose
  max-width 68ch
  color var(--text-secondary)
  line-height 1.9

// Clip the glass layer independently so text, focus rings and menus stay sharp.
@supports (backdrop-filter: blur(1px))
  .site-nav, .side-card, .article-card, .page-panel, .section-heading
    position relative
    isolation isolate
    background transparent
    border-color var(--glass-border)
    &::before
      content ''
      position absolute
      inset 0
      z-index -1
      pointer-events none
      border-radius inherit
      overflow hidden
      background var(--glass-sheen), var(--glass-surface)
      backdrop-filter blur(var(--glass-blur)) saturate(1.12)

  .article-card:hover
    border-color var(--accent-blue)

@media (max-width: 75rem)
  .home-shell
    grid-template-columns 13.5rem minmax(0, 1fr)
    grid-template-areas 'sidebar content' 'utility content'
  .utility-sidebar
    margin-top 0
  .hero__content
    min-height 21rem

@media (max-width: 47rem)
  :root
    --glass-blur 16px
  .hero
    padding-top .65rem
    --hero-position 40% 32%
    &::before
      top 6rem
  .site-nav
    grid-template-columns 1fr auto
    width calc(100% - 1.5rem)
    gap .15rem .5rem
    padding .4rem .65rem
    border-radius 1rem
  .site-nav__brand
    font-size 1rem
  .site-nav__links
    grid-row 2
    grid-column 1 / -1
    justify-content center
    gap .4rem
    a
      flex 1
      min-height 2.25rem
      padding .25rem .6rem
      font-size .85rem
  .site-nav__theme
    grid-row 1
    grid-column 2
  .hero__content
    width calc(100% - 2.5rem)
    min-height 19rem
    align-items flex-end
    padding 6rem 0 3.75rem
  .hero__copy
    width 100%
    h1
      font-size 1.85rem
    h1 .theme-light-only
      font-size clamp(.8rem, 4.25vw, 1.15rem)
      line-height 1.8
      letter-spacing .02em
  .hero:not(.hero--home) .hero__content
    min-height 12rem
    padding 2rem 0 3rem
  .hero__subtitle
    font-size .8rem
    margin-top .6rem
  .hero--home .hero__copy
    width 100%
    padding .85rem 1rem
    border-radius 1rem
    background unquote('color-mix(in srgb, var(--page-bg) 76%, transparent)')
    backdrop-filter blur(8px)
    color var(--text-primary)
  .hero--home .hero__content
    width calc(100% - 2.5rem)
    min-height 23rem
  .hero__edge
    height 2rem
  .home-shell
    width calc(100% - 1.5rem)
    grid-template-columns minmax(0, 1fr)
    grid-template-areas 'content' 'sidebar' 'utility'
    gap 1rem
    margin-top .25rem
  .home-shell--compact
    margin-top 1rem
  .home-shell--archive
    grid-template-areas 'sidebar' 'content' 'utility'
    .sidebar .profile-card, .sidebar .music-card
      display none
  .sidebar, .utility-sidebar
    gap .8rem
  .section-heading
    padding .8rem 1rem
    h2, h1
      font-size 1.1rem
  .page-shell
    width calc(100% - 1.5rem)
    margin-top 1rem
  .site-footer
    width calc(100% - 2rem)
    flex-direction column
    text-align center

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation none !important
    transition none !important
    scroll-behavior auto !important
