---
import { getCollection } from 'astro:content';
import ArticleList from '@components/layout/ArticleList.astro';
import SideBar from '@components/layout/SideBar.astro';
import RightSideBar from '@components/layout/RightSideBar.astro';
import Navbar from '@components/layout/Navbar.astro';
import { siteConfig } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import CategoryBar from '@components/layout/CategoryBar.astro';
import { buildTaxonomyCounts } from '@utils/postStats';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const { categoryCounts, tagCounts } = buildTaxonomyCounts(posts);
---

<BaseLayout>
  <Navbar />

  <main class="home-shell">
    <div class="content-column">
      <CategoryBar categoryCounts={categoryCounts} />
      <ArticleList posts={posts} />
    </div>

    <SideBar />
    <RightSideBar posts={posts} categoryCounts={categoryCounts} tagCounts={tagCounts} />
  </main>

  <footer class="site-footer">
    <p>© {new Date().getFullYear()} {siteConfig.author}</p>
    <p>Built quietly with Astro.</p>
  </footer>
</BaseLayout>
