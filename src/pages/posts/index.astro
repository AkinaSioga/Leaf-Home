---
import { getPosts } from '@utils/content';
import { buildPostStats } from '@utils/postStats';
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/layout/Navbar.astro';
import ArticleTimeline from '@components/layout/ArticleTimeline.astro';
import RightSideBar from '@components/layout/RightSideBar.astro';
import SideBar from '@components/layout/SideBar.astro';
import Footer from '@components/layout/Footer.astro';

const posts = await getPosts();
const stats = buildPostStats(posts);
---

<BaseLayout title="文章" description="一些技术实践，也记下一些日常。按分类和标签，翻阅这里的文章。">
  <Navbar title="文章" subtitle="一些技术实践，也记下一些日常。" />

  <main class="home-shell home-shell--archive" data-post-filter-root>
    <div class="content-column">
      <ArticleTimeline posts={posts} filterable />
    </div>
    <SideBar stats={stats} interactive />
    <RightSideBar posts={posts} totals={stats.totals} />
  </main>

  <Footer stats={stats.totals} />
</BaseLayout>
