---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Navbar from '@components/layout/Navbar.astro';
import Footer from '@components/layout/Footer.astro';
import ArticleTimeline from '@components/layout/ArticleTimeline.astro';
import SideBar from '@components/layout/SideBar.astro';
import RightSideBar from '@components/layout/RightSideBar.astro';
import { buildPostStats } from '@utils/postStats';
import { withBasePath, withPostFilters } from '@utils/url';
interface Props { title: string; posts: CollectionEntry<'posts'>[]; allPosts: CollectionEntry<'posts'>[]; category?: string; tag?: string; }
const { title, posts, allPosts, category, tag } = Astro.props;
const archiveUrl = withPostFilters(withBasePath('/posts/'), category, tag);
const stats = buildPostStats(allPosts);
---
<BaseLayout title={title}>
  <script is:inline define:vars={{ archiveUrl }}>location.replace(archiveUrl);</script>
  <Navbar title={title} subtitle="在文字之间，慢慢翻阅。" />
  <main class="home-shell home-shell--archive">
    <div class="content-column">
      <a class="back-link" href={withBasePath('/posts/')}>← 全部文章</a>
      <ArticleTimeline posts={posts} title={title} />
    </div>
    <SideBar stats={stats} active={category} activeTag={tag} />
    <RightSideBar posts={allPosts} totals={stats.totals} />
  </main>
  <Footer stats={stats.totals} />
</BaseLayout>
