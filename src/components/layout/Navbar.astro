---
import { Image, getImage } from 'astro:assets';
import heroImage from '@assets/hero-banner.webp';
import lightHeroImage from '@assets/hero-banner-light.png';
import logoImg from '@assets/logo.png';
import { navBarConfig } from '@config/navBarConfig';
import { siteConfig } from '@config/site';
import LightDarkSwitch from '@components/controls/LightDarkSwitch.svelte';
import BubbleText from './BubbleText.astro';
import VisitorPendant from '@components/widget/VisitorPendant.astro';
import { withBasePath } from '@utils/url';

interface Props { compact?: boolean; title?: string; subtitle?: string; }
const { compact = false, title = siteConfig.heroTitle, subtitle = siteConfig.heroSubtitle } = Astro.props;
const links = navBarConfig.links;
const lightHero = await getImage({ src: lightHeroImage, width: 1280, format: 'webp', quality: 88 });
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const homeHref = withBasePath('/');
const isHome = !compact && currentPath === homeHref.replace(/\/$/, '');
---

<header class:list={['hero', { 'hero--compact': compact, 'hero--home': isHome }]} id="top" style={`--hero-image-dark: url("${heroImage.src}"); --hero-image-light: url("${lightHero.src}")`}>

  <nav class="site-nav" aria-label="主导航">
    <a class="site-nav__brand" href={homeHref} aria-label={siteConfig.name}>
      <Image
        class="site-nav__logo"
        src={logoImg}
        alt=""
        width={41}
        height={41}
        densities={[1, 2]}
        format="webp"
        loading="eager"
      />
      <span class="site-nav__title">{siteConfig.name}</span>
    </a>

    <div class="site-nav__links">
      {
        links.map((link) => (
          <a href={withBasePath(link.href)} aria-label={link.name}
            aria-current={!link.href.includes('#') && (link.href === '/' ? currentPath === homeHref.replace(/\/$/, '') : currentPath.startsWith(withBasePath(link.href).replace(/\/$/, ''))) ? 'page' : undefined}>
            <span>{link.name}</span>
          </a>
        ))
      }
    </div>

    <div class="site-nav__theme"><LightDarkSwitch client:load /></div>
  </nav>
  {isHome && <VisitorPendant />}

  {!compact && <div class="hero__content">
    <div class="hero__copy">
      <div class="hero__quote">
        <h1>{isHome ? <><span class="theme-light-only"><BubbleText text={siteConfig.lightHeroTitle} splitLines /></span><span class="theme-dark-only"><BubbleText text={title} /></span></> : title}</h1>
        <p class="hero__subtitle">{isHome ? <><span class="theme-light-only"><BubbleText text={siteConfig.lightHeroSubtitle} /></span><span class="theme-dark-only"><BubbleText text={subtitle} /></span></> : subtitle}</p>
        {isHome && <span class="hero__bubbles" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <span />)}</span>}
      </div>
    </div>
  </div>}
  {!compact && <svg class="hero__edge" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" fill="currentColor">
    {isHome && <>
      <path opacity=".26" d="M0 11C174 38 308 3 512 10S800 43 1023 22S1291 1 1440 11V60H0Z" />
      <path opacity=".52" d="M0 24C190 4 334 16 523 28S796 38 1037 24S1305 13 1440 25V60H0Z" />
    </>}
    <path d="M0 26C190 0 300 60 530 35S820 11 1050 35S1290 6 1440 24V60H0Z" />
  </svg>}
</header>

<style lang="stylus">
  @media (max-width: 47rem)
    .hero:not(.hero--home) .hero__copy h1
      max-inline-size calc(100% - 6.5rem)
      overflow-wrap anywhere

  .hero--home .hero__quote
    position relative
    width fit-content
    max-width 100%

  .hero__bubbles
    position absolute
    inset 0
    pointer-events none
    > span
      --bubble-drift 6px
      position absolute
      left 6%
      top 65%
      width .65rem
      height .65rem
      border 1px solid currentColor
      border-radius 50%
      background radial-gradient(circle at 30% 25%, rgba(255, 255, 255, .8) 0 6%, transparent 22%)
      box-shadow inset -1px -1px 2px rgba(255, 255, 255, .3)
      opacity 0
      animation hero-quote-bubble 1.15s ease-out both
      &:nth-child(2)
        --bubble-drift -8px
        left 28%
        top 8%
        width .4rem
        height .4rem
        animation-delay .35s
      &:nth-child(3)
        left 55%
        top 88%
        width .85rem
        height .85rem
        animation-delay .7s
      &:nth-child(4)
        --bubble-drift -5px
        left 78%
        top 32%
        width .45rem
        height .45rem
        animation-delay .2s
      &:nth-child(5)
        left 94%
        top 70%
        animation-delay .5s

  @keyframes hero-quote-bubble
    0%
      opacity 0
      transform translate(0, 10px) scale(.55)
    22%
      opacity .45
    100%
      opacity 0
      transform translate(var(--bubble-drift), -30px) scale(1.15)

  @media (prefers-reduced-motion: reduce)
    .hero__bubbles
      display none
</style>
