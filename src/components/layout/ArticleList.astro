---
import type { CollectionEntry } from 'astro:content';
import { postUrl, taxonomyUrl, dated } from '@utils/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  title?: string;
}

const { posts, title = '最新文章' } = Astro.props;
---

<section class="article-section" id="articles" aria-labelledby="article-heading">
  <div class="section-heading">
    <div>
      <h2 id="article-heading">{title}</h2>
    </div>
    <span>{posts.length} 篇</span>
  </div>

  {
    posts.length > 0 ? (
      <div class="article-list">
        {posts.map((post) => (
          <article class="article-card">
            <h3><a href={postUrl(post.id)}>{post.data.title}</a></h3>
            <div class="article-card__meta">
              <time datetime={post.data.publishedAt.toISOString()}>
                {dated(post.data.publishedAt)}
              </time>
              <a href={taxonomyUrl('categories', post.data.category)}>{post.data.category}</a>
              {post.data.draft && <span>草稿</span>}
            </div>
            <p>{post.data.description}</p>
            <div class="article-card__tags">
              {post.data.tags.map((tag) => <a href={taxonomyUrl('tags', tag)}>#{tag}</a>)}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="empty-state__orb" aria-hidden="true">
          <span>✦</span>
        </div>
        <p class="empty-state__eyebrow">A blank first page</p>
        <h3>这里还很安静</h3>
        <p>文章将从 Markdown 开始，一篇一篇长成这间小屋的模样。</p>
      </div>
    )
  }
</section>
