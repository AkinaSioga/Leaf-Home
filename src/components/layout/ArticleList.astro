---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { postUrl, dated } from '@utils/content';
import { withBasePath } from '@utils/url';
interface Props { posts: CollectionEntry<'posts'>[]; title?: string; }
const { posts, title = '最新文章' } = Astro.props;
---
<section class="article-section" id="articles" aria-labelledby="article-heading">
  <div class="section-heading">
    <h2 id="article-heading">{title}</h2><span>{posts.length} 篇</span>
  </div>
  <div class="article-list">
    {posts.map(post => (
      <article class="article-card">
        <div class="article-card__copy">
          <h3><a href={postUrl(post.id)}>{post.data.title}</a></h3>
          <div class="article-card__meta">
            <time datetime={post.data.publishedAt.toISOString()}><Icon name="material-symbols:calendar-month-outline-rounded" aria-hidden="true" />{dated(post.data.publishedAt)}</time>
            {post.data.draft && <span>草稿</span>}
          </div>
          <p>{post.data.description}</p>
        </div>
        {post.data.cover && <a class="article-card__cover" href={postUrl(post.id)} tabindex="-1" aria-hidden="true">
          <img src={post.data.cover.startsWith('/') ? withBasePath(post.data.cover) : post.data.cover} alt="" loading="lazy" />
          <span class="article-card__arrow"><Icon name="material-symbols:chevron-right-rounded" /></span>
        </a>}
      </article>
    ))}
  </div>
  {posts.length === 0 && <p class="empty-state">这里还很安静。新的文章，慢慢写。</p>}
</section>
<style lang="stylus">
  .article-list
    display grid
    gap 1rem
  .article-card
    display grid
    grid-template-columns minmax(0, 1fr) 26%
    gap 1.1rem
    padding 1.15rem
    transition box-shadow .2s, border-color .2s
    &:hover
      border-color var(--accent-blue)
      box-shadow var(--shadow-card)
  .article-card__copy
    min-width 0
    padding .1rem .1rem .15rem .35rem
  h3
    position relative
    margin 0 0 .6rem
    font-size 1.25rem
    line-height 1.5
    &::before
      content ''
      position absolute
      left -1.5rem
      top .25rem
      width 4px
      height 1.3rem
      border-radius 4px
      background var(--accent-pink)
  .article-card__meta
    display flex
    flex-wrap wrap
    align-items center
    gap .4rem .6rem
    font-size .75rem
    color var(--text-soft)
    time
      display inline-flex
      align-items center
      gap .3rem
    svg
      width 1rem
      height 1rem
      color var(--accent-blue)
  p
    display -webkit-box
    -webkit-line-clamp 2
    -webkit-box-orient vertical
    overflow hidden
    margin .75rem 0 0
    color var(--text-secondary)
    font-size .9rem
    line-height 1.75
  .article-card__cover
    position relative
    min-width 0
    min-height 10rem
    overflow hidden
    border-radius .85rem
    background var(--surface-muted)
    img
      width 100%
      height 100%
      position absolute
      inset 0
      object-fit cover
      object-position 52% center
  .article-card__arrow
    position absolute
    right .6rem
    bottom .6rem
    display grid
    place-items center
    width 1.8rem
    height 1.8rem
    border-radius .6rem
    color var(--accent-blue-strong)
    background var(--surface-raised)
    svg
      width 1.3rem
      height 1.3rem
  @media (max-width: 60rem)
    .article-card
      grid-template-columns minmax(0, 1fr) 24%
      gap .75rem
    h3
      font-size 1.1rem
  @media (max-width: 47rem)
    .article-card
      grid-template-columns minmax(0, 1fr)
      padding 1rem
    .article-card__cover
      grid-row 1
      height 9.5rem
      min-height 0
      img
        object-position center 35%
    .article-card__copy
      padding .15rem .1rem
    h3::before
      left -1.15rem
</style>
