---
import { Image } from 'astro:assets';
import { siteConfig } from '@config/site';
import avatar from '@assets/avatar.jpg';
import PostFilters from './PostFilters.astro';
import MusicPlayer from '@components/widget/MusicPlayer.astro';
import type { PostStats } from '@utils/postStats';
interface Props {
  stats: PostStats;
  interactive?: boolean;
  active?: string;
  activeTag?: string;
}
const { stats, interactive = false, active, activeTag } = Astro.props;
---
<aside class="sidebar" aria-label="个人与分类">
  <section class="side-card profile-card">
    <Image class="profile-card__avatar" src={avatar} alt={`${siteConfig.author} 的头像`} width={240} height={240} />
    <h2>{siteConfig.author}</h2>
    <p>{siteConfig.description}</p>
    <span class="profile-card__rule" aria-hidden="true"></span>
  </section>
  <PostFilters stats={stats} interactive={interactive} active={active} activeTag={activeTag} />
  <MusicPlayer />
</aside>
<style lang="stylus">
  .profile-card
    padding .85rem .85rem 1rem
    text-align center
    h2
      display block
      margin .65rem 0 .15rem
      font-size 1.15rem
    p
      margin 0
      font-size .8rem
  .profile-card__avatar
    display block
    width 100%
    height auto
    aspect-ratio 1
    border-radius .8rem
    object-fit cover
  .profile-card__rule
    display block
    width 1.5rem
    height .2rem
    margin .6rem auto 0
    border-radius 1rem
    background var(--accent-pink)
  @media (max-width: 47rem)
    .profile-card__avatar
      width 8rem
      margin auto
</style>
