---
interface Props { text: string; splitLines?: boolean; }
const { text, splitLines = false } = Astro.props;
const lines = splitLines ? text.split(/(?<=，)/) : [text];
const lastIndex = Math.max(Array.from(text).length - 1, 1);
let offset = 0;
// Each language uses the same entrance window, even when its character count differs.
const glyphLines = lines.map(line => Array.from(line).map(glyph => ({
  glyph,
  delay: Math.round(offset++ / lastIndex * 1800),
})));
---

<span class="bubble-text">
  <span class="bubble-text__label">{text}</span>
  <span aria-hidden="true">{glyphLines.map(line => <span class="bubble-text__line">{line.map(({ glyph, delay }) => <span class="bubble-text__glyph" style={`--bubble-delay: ${delay}ms`}>{glyph}</span>)}</span>)}</span>
</span>

<style lang="stylus">
  .bubble-text__label
    position absolute
    width 1px
    height 1px
    padding 0
    overflow hidden
    clip-path inset(50%)
    white-space nowrap
    user-select none
  .bubble-text__line
    display block
    white-space pre
  .bubble-text__glyph
    display inline-block
    white-space pre
    transform-origin center 65%
    animation hero-letter-bubble 11s ease-in-out infinite both
    animation-delay var(--bubble-delay)

  @keyframes hero-letter-bubble
    0%
      opacity 0
      transform translateY(.65em) scale(.7)
      filter blur(1px)
    4%
      opacity 1
      transform translateY(-.12em) scale(1.06)
      filter blur(0)
    6.5%, 64%
      opacity 1
      transform none
      filter blur(0)
    80%, 100%
      opacity 0
      transform translateY(-.6em) scale(.94)
      filter blur(1px)

  @media (prefers-reduced-motion: reduce)
    .bubble-text__glyph
      animation none
</style>
