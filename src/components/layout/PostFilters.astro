---
import CategoryBar from './CategoryBar.astro';
import { Icon } from 'astro-icon/components';
import { taxonomyUrl } from '@utils/content';
import { withBasePath } from '@utils/url';

interface Props { categoryCounts: Map<string, number>; tagCounts: Map<string, number>; interactive?: boolean; active?: string; }
const { categoryCounts, tagCounts, interactive = false, active } = Astro.props;
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const total = [...categoryCounts.values()].reduce((sum, count) => sum + count, 0);
const allHref = interactive ? `${Astro.url.pathname}#articles` : withBasePath('/posts/');
---

<div class="post-filters" data-post-filters data-posts-href={withBasePath('/posts/')}>
  <section class="side-card category-filter">
    <h2><Icon name="material-symbols:folder-open-outline-rounded" aria-hidden="true" />分类</h2>
    <CategoryBar categoryCounts={categoryCounts} allHref={allHref} active={active} filterable />
  </section>
  <nav class="side-card tag-filter" aria-label="按标签筛选">
    <h2><Icon name="material-symbols:label-outline-rounded" aria-hidden="true" /><span data-tag-label>标签</span></h2>
    <div class="tag-filter__options">
      <a href={allHref} data-filter-tag="" aria-current="true">全部标签<span data-tag-count>{total}</span></a>
      {tags.map(([tag, count]) => <a href={taxonomyUrl('tags', tag)} data-filter-tag={tag}>#{tag}<span data-tag-count>{count}</span></a>)}
    </div>
  </nav>
  <p class="side-card filter-summary" data-filter-summary hidden>
    <span></span><button type="button" data-clear-filter>清除筛选</button>
  </p>
</div>

<script>
  const filters = document.querySelector<HTMLElement>('[data-post-filters]');
  const root = filters?.closest<HTMLElement>('[data-post-filter-root]');
  // Outside the article index, keep static archive URLs as the no-JS fallback.
  if (filters && !root) {
    for (const link of filters.querySelectorAll<HTMLAnchorElement>('a[data-filter-category], a[data-filter-tag]')) {
      const url = new URL(filters.dataset.postsHref!, location.origin);
      const key = link.hasAttribute('data-filter-category') ? 'category' : 'tag';
      const value = link.dataset.filterCategory ?? link.dataset.filterTag;
      if (value) url.searchParams.set(key, value);
      link.href = url.href;
    }
  }
  if (root && filters) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-post-category]')].map(element => ({
      element,
      category: element.dataset.postCategory ?? '',
      tags: JSON.parse(element.dataset.postTags ?? '[]') as string[],
    }));
    const categories = new Set(cards.map(card => card.category));
    const tags = new Set(cards.flatMap(card => card.tags));
    const count = root.querySelector<HTMLElement>('[data-post-count]');
    const title = root.querySelector<HTMLElement>('[data-post-title]');
    const defaultTitle = title?.textContent ?? '最新文章';
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    const summary = filters.querySelector<HTMLElement>('[data-filter-summary]');
    const tagLabel = filters.querySelector<HTMLElement>('[data-tag-label]');
    const categoryLinks = [...filters.querySelectorAll<HTMLAnchorElement>('a[data-filter-category]')];
    const tagLinks = [...filters.querySelectorAll<HTMLAnchorElement>('a[data-filter-tag]')];
    let category = '';
    let tag = '';

    // Keep real archive links as the no-JavaScript / open-in-new-tab path.
    const tagUrls = new Map(tagLinks
      .filter(link => link.dataset.filterTag).map(link => [link.href, link.dataset.filterTag!]));
    for (const link of root.querySelectorAll<HTMLAnchorElement>('.sidebar a')) {
      const value = tagUrls.get(link.href);
      if (value) link.dataset.filterTag = value;
    }

    function render() {
      const categoryCards = cards.filter(card => !category || card.category === category);
      const availableTags = new Map<string, number>();
      for (const card of categoryCards) {
        for (const value of new Set(card.tags)) availableTags.set(value, (availableTags.get(value) ?? 0) + 1);
      }
      let visible = 0;
      for (const card of cards) {
        const matches = (!category || card.category === category) && (!tag || card.tags.includes(tag));
        card.element.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = `${visible} 篇`;
      for (const group of root!.querySelectorAll<HTMLElement>('[data-year-group]')) {
        const yearCount = [...group.querySelectorAll<HTMLElement>('[data-post-category]')].filter(row => !row.hidden).length;
        group.hidden = yearCount === 0;
        const badge = group.querySelector<HTMLElement>('[data-year-count]');
        if (badge) badge.textContent = `${yearCount} 篇文章`;
      }
      if (title) title.textContent = tag ? `#${tag}` : category ? `${category}文章` : defaultTitle;
      if (tagLabel) tagLabel.textContent = category ? `${category}标签` : '标签';
      if (empty) empty.hidden = visible !== 0;
      if (summary) {
        summary.hidden = !category && !tag;
        summary.querySelector('span')!.textContent = [category, tag && `#${tag}`].filter(Boolean).join(' · ');
      }
      for (const link of categoryLinks) {
        const selected = link.dataset.filterCategory === category;
        if (selected) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        link.classList.toggle('category-pill--home', selected);
      }
      for (const link of tagLinks) {
        const value = link.dataset.filterTag ?? '';
        const total = value ? availableTags.get(value) ?? 0 : categoryCards.length;
        link.hidden = Boolean(value) && total === 0;
        link.querySelector<HTMLElement>('[data-tag-count]')!.textContent = String(total);
        if (value === tag) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        if (!value) link.href = categoryLinks.find(item => item.dataset.filterCategory === category)!.href;
      }
    }

    function restore() {
      const params = new URLSearchParams(location.search);
      category = categories.has(params.get('category') ?? '') ? params.get('category')! : '';
      tag = tags.has(params.get('tag') ?? '') ? params.get('tag')! : '';
      if (tag && !cards.some(card => (!category || card.category === category) && card.tags.includes(tag))) tag = '';
      render();
    }

    function remember() {
      const url = new URL(location.href);
      if (category) url.searchParams.set('category', category); else url.searchParams.delete('category');
      if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
      if (url.href !== location.href) history.pushState(null, '', url);
      render();
    }

    root.addEventListener('click', event => {
      if (!(event.target instanceof Element) || event.defaultPrevented || event.button !== 0 ||
        event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const reset = event.target.closest('[data-clear-filter]');
      const link = event.target.closest<HTMLAnchorElement>('a[data-filter-category], a[data-filter-tag]');
      if (!reset && !link) return;
      event.preventDefault();
      if (reset) { category = ''; tag = ''; }
      else if (link!.hasAttribute('data-filter-category')) {
        category = link!.dataset.filterCategory ?? '';
        tag = '';
      } else {
        tag = link!.dataset.filterTag ?? '';
        // A sidebar tag may belong to a different branch; always show its articles.
        if (category && tag && !cards.some(card => card.category === category && card.tags.includes(tag))) category = '';
      }
      remember();
      // Sidebar and card tags can sit far from the results heading on mobile.
      if (link && !filters!.contains(link)) filters!.scrollIntoView({ block: 'start' });
    });
    window.addEventListener('popstate', restore);
    restore();
  }
</script>

<style lang="stylus">
  .post-filters
    display grid
    gap 1rem
    scroll-margin-top 1rem
  .tag-filter
    font-size .8rem
    &__options
      display flex
      flex-wrap wrap
      gap .4rem .5rem
    a
      display inline-flex
      align-items center
      gap .4rem
      min-height 1.85rem
      padding .15rem .5rem
      border 1px solid transparent
      border-radius .65rem
      color var(--text-secondary)
      text-decoration none
      background var(--accent-tint)
      &:hover
        color var(--accent-blue-strong)
        border-color var(--line-soft)
      &[aria-current='true']
        color var(--accent-blue-strong)
        border-color var(--accent-blue)
      span
        min-width 1rem
        color var(--text-soft)
        font-size .7rem
        text-align center
        font-variant-numeric tabular-nums
  .filter-summary
    display flex
    align-items center
    flex-wrap wrap
    gap .8rem
    margin 0
    color var(--text-secondary)
    font-size .8rem
    &[hidden]
      display none
    button
      padding .25rem .5rem
      border 0
      border-radius .4rem
      color var(--accent-blue-strong)
      background var(--surface-muted)
      cursor pointer

  @media (max-width: 47rem)
    .post-filters
      gap .7rem
    .tag-filter a
      min-height 2.25rem
    .category-filter :global(.category-bar), .category-filter :global(.category-bar__scroll)
      display flex
      flex-wrap wrap
      gap .4rem
    .category-filter :global(.category-pill)
      gap .8rem
      min-height 2.5rem
</style>
