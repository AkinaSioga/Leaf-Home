---
import CategoryBar from './CategoryBar.astro';
import { taxonomyUrl } from '@utils/content';
import type { PostStats } from '@utils/postStats';
import { withBasePath } from '@utils/url';

interface Props { stats: PostStats; interactive?: boolean; active?: string; activeTag?: string; }
const { stats, interactive = false, active, activeTag = '' } = Astro.props;
const { total, tags: tagCounts } = stats.all;
const tags = [...tagCounts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const allHref = interactive ? `${Astro.url.pathname}#articles` : withBasePath('/posts/');
---

<div class="post-filters" data-post-filters data-posts-href={withBasePath('/posts/')}>
  <section class="side-card category-filter">
    <h2>分类</h2>
    <CategoryBar stats={stats} allHref={allHref} active={active} interactive={interactive} />
  </section>
  <nav class="side-card tag-filter" aria-label="按标签筛选">
    <details data-tag-disclosure>
      <summary>
        <h2>
          <span><span data-tag-label>标签</span><span class="tag-filter__mobile-label">筛选</span></span>
          <span class="tag-filter__selection" data-tag-selection>{activeTag ? `#${activeTag} · ${tagCounts.get(activeTag)} 篇` : `${total} 篇`}</span>
          <span class="tag-filter__chevron" aria-hidden="true"></span>
        </h2>
      </summary>
      <div class="tag-filter__options">
        <a href={allHref} data-filter-tag="" aria-current={activeTag ? undefined : 'true'}>全部标签<span data-tag-count>{total}</span></a>
        {tags.map(([tag, count]) => <a href={taxonomyUrl('tags', tag)} data-filter-tag={tag} aria-current={tag === activeTag ? 'true' : undefined}>#{tag}<span data-tag-count>{count}</span></a>)}
      </div>
    </details>
  </nav>
  <p class="side-card filter-summary" data-filter-summary hidden>
    <span></span><button type="button" data-clear-filter>清除筛选</button>
  </p>
</div>

<script>
  import { withPostFilters } from '@utils/url';

  const filters = document.querySelector<HTMLElement>('[data-post-filters]');
  const root = filters?.closest<HTMLElement>('[data-post-filter-root]');
  const archivePath = filters?.dataset.postsHref;
  const disclosure = filters?.querySelector<HTMLDetailsElement>('[data-tag-disclosure]');
  const wideScreen = window.matchMedia('(min-width: 47.01rem)');
  if (disclosure) {
    const syncDisclosure = () => { disclosure.open = wideScreen.matches; };
    syncDisclosure();
    wideScreen.addEventListener('change', syncDisclosure);
  }
  const categorySelector = 'a[data-filter-category]';
  const tagSelector = 'a[data-filter-tag]';
  if (archivePath) {
    // The server-rendered links keep category and tag archives usable without JavaScript.
    for (const link of document.querySelectorAll<HTMLAnchorElement>(categorySelector)) {
      link.href = withPostFilters(archivePath, link.dataset.filterCategory);
    }
    for (const link of document.querySelectorAll<HTMLAnchorElement>(tagSelector)) {
      link.href = withPostFilters(archivePath, '', link.dataset.filterTag);
    }
    const back = document.querySelector<HTMLAnchorElement>('[data-return-to-archive]');
    if (back) {
      const params = new URLSearchParams(location.search);
      back.href = withPostFilters(archivePath, params.get('category') ?? '', params.get('tag') ?? '');
    }
  }
  if (root && filters && archivePath) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-post-category]')].map(element => ({
      element,
      postLink: element.querySelector<HTMLAnchorElement>('.timeline__title')!,
      category: element.dataset.postCategory ?? '',
      tags: JSON.parse(element.dataset.postTags ?? '[]') as string[],
    }));
    const count = root.querySelector<HTMLElement>('[data-post-count]');
    const title = root.querySelector<HTMLElement>('[data-post-title]');
    const defaultTitle = title?.textContent ?? '最新文章';
    const empty = root.querySelector<HTMLElement>('[data-filter-empty]');
    const summary = filters.querySelector<HTMLElement>('[data-filter-summary]');
    const tagLabel = filters.querySelector<HTMLElement>('[data-tag-label]');
    const selection = filters.querySelector<HTMLElement>('[data-tag-selection]');
    const categoryLinks = [...filters.querySelectorAll<HTMLAnchorElement>(categorySelector)];
    const groups = new Map(categoryLinks.map(link => {
      const group = JSON.parse(link.dataset.filterCounts!) as { total: number; tags: [string, number][] };
      return [link.dataset.filterCategory!, { total: group.total, tags: new Map(group.tags) }] as const;
    }));
    const tagLinks = [...filters.querySelectorAll<HTMLAnchorElement>(tagSelector)];
    const allTagLinks = [...root.querySelectorAll<HTMLAnchorElement>(tagSelector)];
    let category = '';
    let tag = '';

    function render() {
      const group = groups.get(category)!;
      let visible = 0;
      for (const card of cards) {
        const matches = (!category || card.category === category) && (!tag || card.tags.includes(tag));
        card.element.hidden = !matches;
        if (matches) {
          visible++;
          card.postLink.href = withPostFilters(card.postLink.pathname, category, tag);
        }
      }
      if (count) count.textContent = `${visible} 篇`;
      for (const group of root!.querySelectorAll<HTMLElement>('[data-year-group]')) {
        const yearCount = [...group.querySelectorAll<HTMLElement>('[data-post-category]')].filter(row => !row.hidden).length;
        group.hidden = yearCount === 0;
        const badge = group.querySelector<HTMLElement>('[data-year-count]');
        if (badge) badge.textContent = `${yearCount} 篇文章`;
      }
      if (title) title.textContent = tag ? `#${tag}` : category ? `${category}文章` : defaultTitle;
      if (tagLabel) tagLabel.textContent = category ? `${category}标签` : '标签';
      if (selection) selection.textContent = tag ? `#${tag} · ${visible} 篇` : `${visible} 篇`;
      if (empty) empty.hidden = visible !== 0;
      if (summary) {
        summary.hidden = !category && !tag;
        summary.querySelector('span')!.textContent = [category, tag && `#${tag}`].filter(Boolean).join(' · ');
      }
      for (const link of categoryLinks) {
        const selected = link.dataset.filterCategory === category;
        if (selected) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        link.classList.toggle('category-pill--home', selected);
      }
      for (const link of tagLinks) {
        const value = link.dataset.filterTag ?? '';
        const total = value ? group.tags.get(value) ?? 0 : group.total;
        link.hidden = Boolean(value) && total === 0;
        link.querySelector<HTMLElement>('[data-tag-count]')!.textContent = String(total);
        if (value === tag) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
      for (const link of allTagLinks) {
        link.href = withPostFilters(archivePath!, category, link.dataset.filterTag);
      }
    }

    function restore() {
      const params = new URLSearchParams(location.search);
      const requestedCategory = params.get('category') ?? '';
      const requestedTag = params.get('tag') ?? '';
      category = groups.has(requestedCategory) ? requestedCategory : '';
      tag = groups.get(category)!.tags.has(requestedTag) ? requestedTag : '';
      render();
    }

    function remember() {
      const url = new URL(location.href);
      if (category) url.searchParams.set('category', category); else url.searchParams.delete('category');
      if (tag) url.searchParams.set('tag', tag); else url.searchParams.delete('tag');
      if (url.href !== location.href) history.pushState(null, '', url);
      render();
    }

    root.addEventListener('click', event => {
      if (!(event.target instanceof Element) || event.defaultPrevented || event.button !== 0 ||
        event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const reset = event.target.closest('[data-clear-filter]');
      const link = event.target.closest<HTMLAnchorElement>('a[data-filter-category], a[data-filter-tag]');
      if (!reset && !link) return;
      event.preventDefault();
      if (reset) { category = ''; tag = ''; }
      else if (link!.hasAttribute('data-filter-category')) {
        category = link!.dataset.filterCategory ?? '';
        tag = '';
      } else {
        tag = link!.dataset.filterTag ?? '';
        // A sidebar tag may belong to a different branch; always show its articles.
        if (category && tag && !groups.get(category)!.tags.has(tag)) category = '';
      }
      remember();
      if (!wideScreen.matches && disclosure?.open && link && disclosure.contains(link)) {
        disclosure.open = false;
        disclosure.querySelector('summary')?.focus({ preventScroll: true });
      }
    });
    window.addEventListener('popstate', restore);
    restore();
  }
</script>

<style lang="stylus">
  .post-filters
    display grid
    gap 1rem
    scroll-margin-top 1rem
  .tag-filter
    font-size .8rem
    summary
      cursor pointer
      list-style none
      &::-webkit-details-marker
        display none
      h2
        margin 0
    &__mobile-label, &__selection
      display none
    &__chevron
      width .5rem
      height .5rem
      margin-left auto
      margin-right .2rem
      border solid var(--text-soft)
      border-width 0 1.5px 1.5px 0
      transform rotate(45deg)
    details[open] .tag-filter__chevron
      transform rotate(225deg)
    &__options
      display flex
      flex-wrap wrap
      gap .4rem .5rem
      margin-top .8rem
    a
      display inline-flex
      align-items center
      gap .4rem
      min-height 1.85rem
      padding .15rem .5rem
      border 1px solid transparent
      border-radius .65rem
      color var(--text-secondary)
      text-decoration none
      background var(--accent-tint)
      &:hover
        color var(--accent-blue-strong)
        border-color var(--line-soft)
      &[aria-current='true']
        color var(--accent-blue-strong)
        border-color var(--accent-blue)
      span
        min-width 1rem
        color var(--text-soft)
        font-size .7rem
        text-align center
        font-variant-numeric tabular-nums
  .filter-summary
    display flex
    align-items center
    flex-wrap wrap
    gap .8rem
    margin 0
    color var(--text-secondary)
    font-size .8rem
    &[hidden]
      display none
    button
      padding .25rem .5rem
      border 0
      border-radius .4rem
      color var(--accent-blue-strong)
      background var(--surface-muted)
      cursor pointer

  @media (max-width: 47rem)
    .post-filters
      gap .5rem
    .category-filter, .tag-filter
      padding .55rem .85rem
    .category-filter h2
      margin-bottom .35rem
    .tag-filter summary h2
      min-height 2.5rem
    .tag-filter__mobile-label, .tag-filter__selection
      display inline
    .tag-filter__selection
      margin-left auto
      font-size .76rem
      font-weight 500
      color var(--text-secondary)
    .tag-filter__chevron
      margin-left .15rem
    .filter-summary
      padding .3rem .85rem
    .tag-filter a
      min-height 2.25rem
    .category-filter :global(.category-bar), .category-filter :global(.category-bar__scroll)
      display flex
      flex-wrap wrap
      gap .4rem
    .category-filter :global(.category-pill)
      gap .8rem
      min-height 2.5rem
</style>
