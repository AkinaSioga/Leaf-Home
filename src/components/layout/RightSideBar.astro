---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Calendar from '@components/widget/Calendar.astro';
import ShortNotes from '@components/widget/ShortNotes.astro';
import Now from '@components/widget/Now.astro';
import type { PostStats } from '@utils/postStats';
import { withBasePath } from '@utils/url';
interface Props { posts: CollectionEntry<'posts'>[]; totals: PostStats['totals']; }
const { posts, totals } = Astro.props;
---
<aside class="utility-sidebar" aria-label="日常与站点信息">
  <ShortNotes />
  <section class="side-card stats-card" aria-labelledby="stats-title">
    <h2 id="stats-title">站点统计</h2>
    <dl>
      <div><dt><Icon name="material-symbols:description-outline-rounded" aria-hidden="true" />文章</dt><dd>{totals.posts}</dd></div>
      <div><dt><Icon name="material-symbols:folder-open-outline-rounded" aria-hidden="true" />分类</dt><dd>{totals.categories}</dd></div>
      <div><dt><Icon name="material-symbols:label-outline-rounded" aria-hidden="true" />标签</dt><dd>{totals.tags}</dd></div>
    </dl>
  </section>
  <section class="side-card calendar-card" aria-label="文章日历">
    <Calendar posts={posts} compact />
    <noscript><p><a href={withBasePath('/posts/')}>查看文章归档</a></p></noscript>
  </section>
  <Now />
</aside>
<style lang="stylus">
  dl
    margin 0
  dl > div
    display flex
    align-items center
    justify-content space-between
    padding .4rem 0
    font-size .85rem
    &:not(:last-child)
      border-bottom 1px solid var(--line-soft)
  dt
    display flex
    align-items center
    gap .6rem
    color var(--text-secondary)
    svg
      width 1.1rem
      height 1.1rem
      color var(--accent-blue)
  dd
    margin 0
    font-weight 700
    font-variant-numeric tabular-nums
  .calendar-card
    padding 1rem .75rem
</style>
