---
import type { CollectionEntry } from 'astro:content';
import Calendar from '@components/widget/Calendar.astro';
import { postUrl, taxonomyUrl } from '@utils/content';
interface Props { posts: CollectionEntry<'posts'>[]; tagCounts: Map<string, number>; }
const { posts, tagCounts } = Astro.props;
const tags = [...tagCounts.keys()];
---
{tags.length > 0 && <section class="side-card" aria-labelledby="tags-heading">
  <h2 id="tags-heading">标签</h2>
  <div class="tag-cloud">{tags.map(tag => <a href={taxonomyUrl('tags', tag)}>#{tag}</a>)}</div>
</section>}
<details class="side-card archive-card">
  <summary>文章归档 <span class="side-card__count">· {posts.length} 篇</span></summary>
  <div class="archive-card__body">
    <Calendar posts={posts} />
    <noscript><ul class="archive-list">{posts.map(post => <li><a href={postUrl(post.id)}>{post.data.publishedAt.toISOString().slice(0, 10)} · {post.data.title}</a></li>)}</ul></noscript>
  </div>
</details>
