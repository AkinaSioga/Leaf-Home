---
import type { CollectionEntry } from 'astro:content';
import Calendar from '@components/widget/Calendar.astro';
import SiteStats from '@components/widget/SiteStats.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  categoryCounts: Map<string, number>;
  tagCounts: Map<string, number>;
}

const { posts, categoryCounts, tagCounts } = Astro.props;
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---



<aside class="sidebar sidebar--right" aria-label="分类与标签">
  
  <SiteStats posts={posts} categoryCounts={categoryCounts} tagCounts={tagCounts} />

  <!-- 分类 -->
  <section class="side-card taxonomy-card" id="categories">
    <div class="side-card__heading">
      <div>
        <p class="side-card__eyebrow">Categories</p>
        <h2>分类</h2>
      </div>
      <span class="side-card__count">{categories.length}</span>
    </div>

    {
      categories.length > 0 ? (
        <ul class="taxonomy-list">
          {categories.map(([name, count]) => (
            <li>
              <span>{name}</span>
              <span class="taxonomy-list__count">{count}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p>第一篇文章发布后，这里会自动生成分类。</p>
      )
    }
  </section>

  <!-- 标签 -->
  <section class="side-card taxonomy-card" id="tags">
    <div class="side-card__heading">
      <div>
        <p class="side-card__eyebrow">Tags</p>
        <h2>标签</h2>
      </div>
      <span class="side-card__count">{tags.length}</span>
    </div>

    {
      tags.length > 0 ? (
        // 标签页路由尚未建立，暂用非链接的胶囊；等 /tags 页做好后再换成 <a>。
        <div class="tag-cloud">
          {tags.map(([name]) => <span>#{name}</span>)}
        </div>
      ) : (
        <p>写下第一个标签，标签云就会在这里聚拢。</p>
      )
    }
  </section>

  <!-- 日历 -->
  <section class="side-card">
    <Calendar posts={posts} />
  </section>
</aside>



<style lang="stylus">
  .taxonomy-card
    padding 1rem

  .taxonomy-card h2
    font-size 1.125rem

  .taxonomy-list
    display grid
    gap .35rem
    margin .85rem 0 0
    padding 0
    list-style none

  .taxonomy-list li
    display flex
    align-items center
    justify-content space-between
    gap .75rem
    min-height 2.5rem
    padding .35rem .45rem
    border-radius .75rem
    color var(--text-secondary)
    transition background .2s ease, color .2s ease, transform .2s ease

    &:hover
      color var(--accent-blue-strong)
      background var(--surface-muted)
      transform translateX(.15rem)

  .taxonomy-list__count
    display grid
    min-width 2rem
    height 1.75rem
    padding 0 .45rem
    place-items center
    border-radius .6rem
    color #fff
    background var(--accent-blue)
    font-size .76rem
    font-weight 800

  .tag-cloud
    display flex
    flex-wrap wrap
    gap .5rem
    margin-top .85rem

  .tag-cloud span
    display inline-flex
    align-items center
    min-height 2rem
    padding .3rem .7rem
    border-radius .65rem
    color var(--text-secondary)
    background var(--surface-muted)
    font-size .875rem
    line-height 1
    transition color .2s ease, background .2s ease, transform .2s ease

    &:hover
      color #fff
      background var(--accent-blue)
      transform translateY(-2px)  
</style>
