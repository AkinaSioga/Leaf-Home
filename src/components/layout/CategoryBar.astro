---
import { taxonomyUrl } from '@utils/content';
import { withBasePath } from '@utils/url';

interface Props {
  categoryCounts: Map<string, number>;
  active?: string;
  filterable?: boolean;
  allHref?: string;
}

const { categoryCounts, active, filterable = false, allHref = withBasePath('/posts/') } = Astro.props;

const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const total = categories.reduce((sum, [, count]) => sum + count, 0);
---

<nav class="category-bar" aria-label="文章分类">
    <a class:list={['category-pill', { 'category-pill--home': !active }]} href={allHref} data-filter-category={filterable ? '' : undefined} aria-current={!active ? 'page' : undefined}>
      全部文章
      <span class="category-pill__count">{total}</span>
    </a>

  <div class="category-bar__scroll">
    {
      categories.map(([name, count]) => (
        <a class:list={['category-pill', { 'category-pill--home': active === name }]} href={taxonomyUrl('categories', name)} data-filter-category={filterable ? name : undefined} aria-current={active === name ? 'page' : undefined}>
          {name}
          <span class="category-pill__count">{count}</span>
        </a>
      ))
    }
  </div>
</nav>

<style lang="stylus">
  .category-bar
    display grid
    gap .25rem
    min-width 0
    padding 0

  .category-pill
    display inline-flex
    flex-shrink 0
    align-items center
    justify-content space-between
    gap .4rem
    min-height 2.35rem
    padding .35rem .65rem
    border-radius .7rem
    color var(--text-secondary)
    background transparent
    font-size .86rem
    font-weight 600
    line-height 1
    text-decoration none
    transition color .2s ease, background .2s ease

  a.category-pill:hover
    color var(--accent-blue-strong)
    background var(--surface-raised)

  .category-pill--home
    color var(--text-primary)
    background var(--accent-tint)
    color var(--accent-blue-strong)

  .category-pill__count
    display inline-flex
    align-items center
    justify-content center
    min-width 1.4rem
    min-height 1.4rem
    padding .1rem .35rem
    border-radius .45rem
    color var(--text-soft)
    background var(--surface-muted)
    font-size .72rem
    font-weight 700
    font-variant-numeric tabular-nums

  .category-pill--home .category-pill__count
    color var(--accent-pink-strong)
    background var(--surface-raised)

  .category-bar__scroll
    display grid
    min-width 0
    gap .25rem
</style>
