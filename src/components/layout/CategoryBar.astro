---
import { taxonomyUrl } from '@utils/content';
import { withBasePath } from '@utils/url';

interface Props {
  categoryCounts: Map<string, number>;
  active?: string;
}

const { categoryCounts, active } = Astro.props;

const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<nav class="category-bar" aria-label="文章分类">
    <a class:list={['category-pill', { 'category-pill--home': !active }]} href={withBasePath('/#articles')} aria-current={!active ? 'page' : undefined}>
      全部
    </a>

  <div class="category-bar__scroll">
    {
      categories.map(([name, count]) => (
        <a class:list={['category-pill', { 'category-pill--home': active === name }]} href={taxonomyUrl('categories', name)} aria-current={active === name ? 'page' : undefined}>
          {name}
          <span class="category-pill__count">{count}</span>
        </a>
      ))
    }
  </div>
</nav>

<style lang="stylus">
  .category-bar
    display flex
    align-items center
    gap .5rem
    min-width 0
    padding 0

  .category-pill
    display inline-flex
    flex-shrink 0
    align-items center
    justify-content center
    gap .4rem
    min-height 2.75rem
    padding .35rem .85rem
    border-radius .75rem
    color var(--text-secondary)
    background transparent
    font-size .86rem
    font-weight 600
    line-height 1
    text-decoration none
    transition color .2s ease, background .2s ease

  a.category-pill:hover
    color var(--accent-blue-strong)
    background var(--surface-raised)

  .category-pill--home
    color var(--text-primary)
    background var(--surface-muted)
    box-shadow inset 0 -2px 0 var(--accent-pink)

  .category-pill__count
    color var(--text-soft)
    font-size .68rem
    font-weight 700

  .category-bar__scroll
    display flex
    flex 1
    min-width 0
    gap .5rem
    overflow-x auto
    scrollbar-width none

    &::-webkit-scrollbar
      display none
</style>
