---
import { taxonomyUrl } from '@utils/content';
import type { PostStats, TagGroup } from '@utils/postStats';
import { withBasePath } from '@utils/url';

interface Props {
  stats: PostStats;
  active?: string;
  interactive?: boolean;
  allHref?: string;
}

const { stats, active, interactive = false, allHref = withBasePath('/posts/') } = Astro.props;
const categories = [...stats.categories].sort((a, b) => b[1].total - a[1].total);
const filterCounts = ({ total, tags }: TagGroup) =>
  interactive ? JSON.stringify({ total, tags: [...tags] }) : undefined;
---

<nav class="category-bar" aria-label="文章分类">
    <a class:list={['category-pill', { 'category-pill--home': !active }]} href={allHref} data-filter-category="" data-filter-counts={filterCounts(stats.all)} aria-current={!active ? 'page' : undefined}>
      全部文章
      <span class="category-pill__count">{stats.all.total}</span>
    </a>

  <div class="category-bar__scroll">
    {
      categories.map(([name, group]) => (
        <a class:list={['category-pill', { 'category-pill--home': active === name }]} href={taxonomyUrl('categories', name)} data-filter-category={name} data-filter-counts={filterCounts(group)} aria-current={active === name ? 'page' : undefined}>
          {name}
          <span class="category-pill__count">{group.total}</span>
        </a>
      ))
    }
  </div>
</nav>

<style lang="stylus">
  .category-bar
    display grid
    gap .25rem
    min-width 0
    padding 0

  .category-pill
    display inline-flex
    flex-shrink 0
    align-items center
    justify-content space-between
    gap .4rem
    min-height 2.35rem
    padding .35rem .65rem
    border-radius .7rem
    color var(--text-secondary)
    background transparent
    font-size .86rem
    font-weight 600
    line-height 1
    text-decoration none
    transition color .2s ease, background .2s ease

  a.category-pill:hover
    color var(--accent-blue-strong)
    background var(--surface-raised)

  .category-pill--home
    color var(--text-primary)
    background var(--accent-tint)
    color var(--accent-blue-strong)

  .category-pill__count
    display inline-flex
    align-items center
    justify-content center
    min-width 1.4rem
    min-height 1.4rem
    padding .1rem .35rem
    border-radius .45rem
    color var(--text-soft)
    background var(--surface-muted)
    font-size .72rem
    font-weight 700
    font-variant-numeric tabular-nums

  .category-pill--home .category-pill__count
    color var(--accent-pink-strong)
    background var(--surface-raised)

  .category-bar__scroll
    display grid
    min-width 0
    gap .25rem
</style>
