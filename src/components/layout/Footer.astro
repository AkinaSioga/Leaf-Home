---
import { siteConfig } from '@config/site';
import type { PostStats } from '@utils/postStats';
interface Props { stats?: PostStats['totals']; }
const { stats } = Astro.props;
---
<footer class="site-footer">
  <p>© {new Date().getFullYear()} {siteConfig.author}</p>
  {stats && <p>{stats.posts} 篇文章 · {stats.categories} 个分类 · {stats.tags} 个标签</p>}
  <p>Built quietly with Astro.</p>
</footer>
