---
import { personalConfig } from '@config/personal';
import { Icon } from 'astro-icon/components';

const notes = [...personalConfig.notes]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);
---

<section class="side-card notes-card" aria-labelledby="notes-title">
  <div class="side-card__heading">
    <div>
      <h2 id="notes-title"><Icon name="material-symbols:chat-bubble-outline-rounded" aria-hidden="true" />碎碎念</h2>
    </div>
  </div>
  {notes.length > 0 ? (
    <ol>
      {notes.map((note) => (
        <li>
          <time datetime={note.date}>{note.date.replaceAll('-', '.')}</time>
          <p>{note.text}</p>
        </li>
      ))}
    </ol>
  ) : <p>留一点地方，给日常的小发现。</p>}
</section>

<style lang="stylus">
  .notes-card
    display block
    min-width 0

  .side-card__heading
    flex-shrink 0

  .notes-card h2
    margin 0 0 .8rem

  ol
    display grid
    gap 1rem
    margin 0
    padding 0
    list-style none

  li
    padding-left 0
    overflow-wrap anywhere

  time
    color var(--text-secondary)
    font-size .75rem
    font-variant-numeric tabular-nums

  .notes-card li p
    display block
    margin .4rem 0 0
    white-space pre-line
    line-height 1.6

  @media (max-width: 47rem)
    .notes-card
      display block
    ol
      margin-top .3rem
</style>
