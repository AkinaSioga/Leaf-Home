---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { buildPostCalendar } from '@utils/postCalendar';

interface Props {
    posts: CollectionEntry<'posts'>[];
    compact?: boolean;
}

const { posts, compact = false } = Astro.props;
const calendarIndex = buildPostCalendar(posts);
---

<div class="calendar" data-calendar-index={JSON.stringify(calendarIndex)} data-compact={compact ? '' : undefined}>
    <!-- 头部 -->
     <div class="calendar__header">
        <button id="calendar-prev" class="calendar__prev" type="button" aria-label="上个月">
            <Icon name="material-symbols:chevron-left-rounded" aria-hidden="true" />
        </button>
        <span class="calendar__title" id="calendar-title"></span>
        <button id="calendar-next" class="calendar__next" type="button" aria-label="下个月">
            <Icon name="material-symbols:chevron-right-rounded" aria-hidden="true" />
        </button>
    </div>

    <!-- 星期 -->
     <div class="calendar__week">
        <span>日</span>
        <span>一</span>
        <span>二</span>
        <span>三</span>
        <span>四</span>
        <span>五</span>
        <span>六</span>
     </div>

     <!-- 日历主体 -->
      <div id="calendar-body" class="calendar__body">
        <!-- 日历格子将在这里生成 -->
      </div>

      <div id="calendar-posts" class="calendar__posts" role="region" aria-label="日历文章" hidden={compact}></div>

      <div id="calendar-heatmap" class="calendar__heatmap" role="group" aria-label="文章发布热力图">
        <!-- 日历热力图将在这里生成 -->
      </div>

      <div id="calendar-tooltip" class="calendar__tooltip" role="tooltip" hidden>
        <!-- 提示信息将在这里生成 -->
      </div>

</div>

<script>
    import type { CalendarIndex } from '@utils/postCalendar';

    function initCalendar(calendar: HTMLElement) {
        const index: CalendarIndex = JSON.parse(calendar.dataset.calendarIndex!);
        const compact = calendar.hasAttribute('data-compact');
        const today = new Date();
        let year = today.getFullYear();
        let month = today.getMonth();
        const titleEl = calendar.querySelector<HTMLElement>('#calendar-title')!;
        const bodyEl = calendar.querySelector<HTMLElement>('#calendar-body')!;
        const postsEl = calendar.querySelector<HTMLElement>('#calendar-posts')!;
        const heatmapEl = calendar.querySelector<HTMLElement>('#calendar-heatmap')!;
        const tooltipEl = calendar.querySelector<HTMLElement>('#calendar-tooltip')!;
        document.body.appendChild(tooltipEl);

        function hideHeatmapTooltip() {
            tooltipEl.hidden = true;
        }

        function focusedHeatCell() {
            return heatmapEl.querySelector<HTMLButtonElement>('.calendar__heat:focus-visible');
        }

        function showHeatmapTooltip(cell: HTMLButtonElement) {
            // Changing months can move the grid under a stationary pointer.
            const target = focusedHeatCell() ?? cell;
            const rect = target.getBoundingClientRect();
            if (rect.bottom <= 0 || rect.top >= window.innerHeight) {
                hideHeatmapTooltip();
                return;
            }
            tooltipEl.textContent = target.getAttribute('aria-label');
            tooltipEl.hidden = false;
            const tooltipRect = tooltipEl.getBoundingClientRect();
            const margin = 8;
            const viewportWidth = document.documentElement.clientWidth;
            const left = Math.max(margin + tooltipRect.width / 2,
                Math.min(rect.left + rect.width / 2, viewportWidth - margin - tooltipRect.width / 2));
            const above = rect.top - tooltipRect.height - margin;
            const top = above >= margin ? above : rect.bottom + margin;
            tooltipEl.style.left = `${left}px`;
            tooltipEl.style.top = `${Math.max(margin, Math.min(top, window.innerHeight - tooltipRect.height - margin))}px`;
        }

        function renderHeatmap() {
            heatmapEl.setAttribute('aria-label', `${year}年文章发布热力图`);
            let html = Array.from({ length: 12 }, (_, i) =>
                `<span class="calendar__heatmap-month" aria-hidden="true">${i + 1}</span>`).join('');
            for (let band = 0; band < 4; band++) {
                for (let m = 0; m < 12; m++) {
                    const count = index[year]?.[m]?.bands[band] ?? 0;
                    const firstDay = band * 7 + 1;
                    const lastDay = band === 3 ? new Date(year, m + 1, 0).getDate() : firstDay + 6;
                    const label = `${year}年${m + 1}月${firstDay}–${lastDay}日：${count}篇文章`;
                    html += `<button type="button" class="calendar__heat" data-level="${Math.min(count, 4)}" data-month="${m}" aria-label="${label}"></button>`;
                }
            }
            heatmapEl.innerHTML = html;
        }

        function renderPosts(selectedDay?: number) {
            postsEl.replaceChildren();
            postsEl.hidden = compact && selectedDay === undefined;
            if (postsEl.hidden) return;

            const days = index[year]?.[month]?.days ?? {};
            const dates = selectedDay === undefined
                ? Object.keys(days).map(Number).sort((a, b) => b - a)
                : [selectedDay];
            if (dates.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'calendar__posts-empty';
                empty.textContent = '本月暂无文章。';
                postsEl.appendChild(empty);
                return;
            }
            const fragment = document.createDocumentFragment();
            if (selectedDay !== undefined) {
                const caption = document.createElement('p');
                caption.className = 'calendar__selection';
                caption.textContent = `${month + 1}月${selectedDay}日 · ${days[selectedDay].length} 篇文章`;
                fragment.appendChild(caption);
            }
            for (const day of dates) {
                for (const post of days[day]) {
                    const item = document.createElement('div');
                    item.className = 'calendar__post';
                    const link = document.createElement('a');
                    link.className = 'calendar__post-title';
                    link.href = post.url;
                    link.textContent = post.title;
                    item.appendChild(link);
                    if (selectedDay === undefined) {
                        const dateLabel = document.createElement('span');
                        dateLabel.className = 'calendar__post-date';
                        dateLabel.textContent = `${month + 1}-${day}`;
                        item.appendChild(dateLabel);
                    }
                    fragment.appendChild(item);
                }
            }
            postsEl.appendChild(fragment);
        }

        function renderMonth() {
            const startWeekday = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const days = index[year]?.[month]?.days ?? {};
            const currentMonth = year === today.getFullYear() && month === today.getMonth();
            titleEl.textContent = `${year}年${month + 1}月`;

            let html = '<span class="calendar__cell calendar__cell--empty"></span>'.repeat(startWeekday);
            for (let day = 1; day <= daysInMonth; day++) {
                const count = days[day]?.length ?? 0;
                const cellClass = `calendar__cell${currentMonth && day === today.getDate() ? ' is-today' : ''}`;
                const dateLabel = `<span class="calendar__day">${day}</span>`;
                if (count === 0) {
                    html += `<span class="${cellClass}">${dateLabel}</span>`;
                } else {
                    const label = `${year}年${month + 1}月${day}日，${count}篇文章`;
                    const multiple = count > 1;
                    const badge = multiple ? `<span class="calendar__count">${count}</span>` : '';
                    html += `<button type="button" class="${cellClass} has-post${multiple ? ' has-multiple' : ''}" data-day="${day}" aria-label="${label}" aria-expanded="false" aria-controls="calendar-posts">${dateLabel}${badge}</button>`;
                }
            }
            bodyEl.innerHTML = html;
            renderPosts();
        }

        function updateTooltipPosition() {
            const cell = focusedHeatCell();
            if (cell) showHeatmapTooltip(cell);
            else hideHeatmapTooltip();
        }

        function showMonth(nextMonth: number) {
            const date = new Date(year, nextMonth, 1);
            const yearChanged = date.getFullYear() !== year;
            year = date.getFullYear();
            month = date.getMonth();
            renderMonth();
            if (yearChanged) renderHeatmap();
            updateTooltipPosition();
        }

        bodyEl.addEventListener('click', event => {
            if (!(event.target instanceof Element)) return;
            const button = event.target.closest<HTMLButtonElement>('button[data-day]');
            if (!button) return;
            const open = button.getAttribute('aria-expanded') !== 'true';
            bodyEl.querySelector('[aria-expanded="true"]')?.setAttribute('aria-expanded', 'false');
            button.setAttribute('aria-expanded', String(open));
            renderPosts(open ? Number(button.dataset.day) : undefined);
        });
        calendar.querySelector('#calendar-prev')!.addEventListener('click', () => showMonth(month - 1));
        calendar.querySelector('#calendar-next')!.addEventListener('click', () => showMonth(month + 1));

        heatmapEl.addEventListener('click', event => {
            if (event.target instanceof HTMLButtonElement) showMonth(Number(event.target.dataset.month));
        });
        function showCellTooltip(event: Event) {
            if (event.target instanceof HTMLButtonElement) showHeatmapTooltip(event.target);
        }
        heatmapEl.addEventListener('pointerover', showCellTooltip);
        heatmapEl.addEventListener('pointerout', updateTooltipPosition);
        heatmapEl.addEventListener('focusin', showCellTooltip);
        heatmapEl.addEventListener('focusout', hideHeatmapTooltip);
        window.addEventListener('scroll', updateTooltipPosition, { passive: true });
        window.addEventListener('resize', updateTooltipPosition);
        renderMonth();
        renderHeatmap();
    }

    const calendar = document.querySelector<HTMLElement>('[data-calendar-index]');
    if (calendar) initCalendar(calendar);
</script>

<style lang="stylus">
    .calendar__header
        display flex
        align-items center
        justify-content space-between
        margin-bottom .75rem

    .calendar__prev,
    .calendar__next
        display grid
        place-items center
        width 2rem
        height 2rem
        border 0
        border-radius .6rem
        color var(--accent-blue-strong)
        background var(--accent-tint)
        cursor pointer
        transition background .2s ease, color .2s ease
        &:hover
            background var(--accent-tint-strong)

    .calendar__title
        font-size .95rem
        font-weight 700

    .calendar__week,
    .calendar__body
        display grid
        grid-template-columns repeat(7, minmax(0, 1fr))
        gap .25rem

    .calendar__week span
        text-align center
        font-size .72rem
        color var(--text-soft)

    .calendar__body :global(.calendar__cell)
        display grid
        grid-template-rows .65rem minmax(0, 1fr) .35rem
        place-items center
        min-height 1.85rem
        aspect-ratio 1
        border-radius .5rem
        font-size .82rem
        line-height 1
        font-variant-numeric tabular-nums
        color var(--text-secondary)

    .calendar__body :global(.calendar__cell.has-post)
        position relative
        padding 0
        border 0
        background transparent
        color var(--text-primary)
        font-weight 700
        cursor pointer
        &::after
            content ''
            position absolute
            bottom .1rem
            width .2rem
            height .2rem
            border-radius 50%
            background var(--accent-pink-strong)

    .calendar__body :global(.has-post[aria-expanded="true"]),
    .calendar__body :global(.has-post:hover)
        background var(--accent-tint)
        box-shadow inset 0 0 0 1px var(--accent-blue)

    .calendar__body :global(.calendar__cell.is-today)
        border-radius .65rem
        color var(--accent-blue-strong)
        font-weight 700
        background var(--accent-tint)
        box-shadow inset 0 0 0 1px var(--accent-blue)

    .calendar__body :global(.calendar__cell.has-multiple)::after
        display none

    .calendar__body :global(.calendar__day)
        grid-area 2 / 1

    .calendar__body :global(.calendar__count)
        grid-area 1 / 1
        place-self start end
        margin .07rem .12rem 0 0
        font-size .52rem
        font-weight 700
        color var(--accent-blue-strong)

    

    .calendar__posts
        margin-top .85rem
        padding-top .75rem
        border-top 1px solid var(--line-soft)
        display flex
        flex-direction column
        gap .3rem
        max-height 12rem
        overflow-y auto

    .calendar__posts :global(.calendar__post)
        display flex
        align-items center
        justify-content space-between
        gap .6rem
        padding .3rem .4rem
        border-radius .5rem
        font-size .8rem
        color var(--text-secondary)

        &:hover
            background var(--surface-muted)

    .calendar__posts :global(.calendar__post-title)
        overflow-wrap anywhere
        text-underline-offset .2em

    .calendar__posts :global(.calendar__selection)
        margin 0 0 .2rem
        font-size .78rem
        font-weight 650
        color var(--text-secondary)

    .calendar__posts :global(.calendar__post-date)
        flex-shrink 0
        font-size .72rem
        color var(--text-soft)

    .calendar__posts :global(.calendar__posts-empty)
        margin 0
        font-size .8rem
        color var(--text-soft)

    .calendar__heatmap
        margin-top .85rem
        display grid
        grid-template-columns repeat(12, 1fr)
        gap .18rem

    .calendar__heatmap :global(.calendar__heatmap-month)
        padding-bottom .15rem
        text-align center
        color var(--text-soft)
        font-size .6rem
        line-height 1.4

    .calendar__heatmap :global(.calendar__heat)
        display block
        padding 0
        border 0
        cursor pointer
        aspect-ratio 1
        border-radius .2rem
        background var(--accent-tint)           // 0 篇：浅色网格

    .calendar__heatmap :global(.calendar__heat[data-level="1"])
        background var(--accent-pink)
        opacity .4
    .calendar__heatmap :global(.calendar__heat[data-level="2"])
        background var(--accent-pink)
        opacity .6
    .calendar__heatmap :global(.calendar__heat[data-level="3"])
        background var(--accent-pink)
        opacity .8
    .calendar__heatmap :global(.calendar__heat[data-level="4"])
        background var(--accent-pink)
        opacity 1

    .calendar__tooltip
        position fixed
        z-index 9999
        padding .4rem .65rem
        border 1px solid rgba(255, 255, 255, .12)
        border-radius .5rem
        color #fff
        background rgba(24, 24, 38, .9)
        box-shadow 0 .4rem 1.2rem rgba(0, 0, 0, .2)
        font-size .72rem
        line-height 1.3
        width max-content
        max-width calc(100vw - 1rem)
        pointer-events none
        transform translateX(-50%)

</style>
