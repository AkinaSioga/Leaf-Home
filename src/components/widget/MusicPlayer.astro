---
import { musicTracks } from '@config/music';
import { withBasePath } from '@utils/url';
---
{musicTracks.length > 0 && <section class="side-card music-card" aria-labelledby="music-title">
  <h2 id="music-title">音乐</h2>
  <ul class="music-card__tracks">
    {musicTracks.map(track => <li>
      <p>{track.title}</p>
      <audio controls preload="none" aria-label={track.title} src={track.src.startsWith('/') ? withBasePath(track.src) : track.src}></audio>
    </li>)}
  </ul>
</section>}
<style lang="stylus">
  .music-card__tracks
    display grid
    gap .75rem
    margin 0
    padding 0
    list-style none
    audio
      display block
      width 100%
      margin-top .35rem
</style>
