---
import { Icon } from 'astro-icon/components';
---
<section class="side-card music-card" aria-labelledby="music-title">
  <h2 id="music-title"><Icon name="material-symbols:music-note-rounded" aria-hidden="true" />音乐</h2>
  <p class="music-card__empty">暂无曲目</p>
  <div class="music-card__progress" aria-hidden="true"></div>
  <div class="music-card__controls" role="group" aria-label="音乐播放控制，暂无曲目">
    <button type="button" disabled aria-label="上一曲"><Icon name="material-symbols:skip-previous-rounded" /></button>
    <button class="music-card__play" type="button" disabled aria-label="播放"><Icon name="material-symbols:play-arrow-rounded" /></button>
    <button type="button" disabled aria-label="下一曲"><Icon name="material-symbols:skip-next-rounded" /></button>
  </div>
</section>
<style lang="stylus">
  .music-card__empty
    text-align center
    font-size .75rem
  .music-card__progress
    height .25rem
    margin 1rem 0 .65rem
    border-radius 1rem
    background var(--accent-tint)
  .music-card__controls
    display flex
    align-items center
    justify-content center
    gap 1.35rem
    button
      display grid
      place-items center
      width 2rem
      height 2rem
      padding 0
      border 0
      background transparent
      color var(--accent-blue)
      cursor default
      svg
        width 1.25rem
        height 1.25rem
    .music-card__play
      border-radius 50%
      color var(--surface-raised)
      background var(--accent-blue)
</style>
